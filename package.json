{
  "name": "dsh-pi-agent",
  "version": "0.1.1",
  "description": "Use the Pi coding agent (@earendil-works/pi-coding-agent) as the agent loop inside DeepSeek Harness (@deepseek-ai/dsh): drive pi --mode rpc from the official DSH web UI, swap subagents to pi, zero prompt injection.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./subagent": {
      "types": "./dist/subagent.d.ts",
      "default": "./dist/subagent.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-agent",
    "dsh-extensions",
    "pi",
    "pi-coding-agent",
    "pi-extensions",
    "earendil-works",
    "agent-loop",
    "coding-agent",
    "harness",
    "cordis",
    "agent"
  ],
  "license": "MIT",
  "author": "Micheleww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Micheleww/dsh-pi-agent.git"
  },
  "homepage": "https://github.com/Micheleww/dsh-pi-agent#readme",
  "bugs": {
    "url": "https://github.com/Micheleww/dsh-pi-agent/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-scope": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
