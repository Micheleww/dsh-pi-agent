{
  "name": "dsh-pi-agent",
  "version": "0.1.1",
  "description": "Run the Pi coding agent loop inside DeepSeek Harness (DSH): a DSH Agent implementation that drives a headless `pi --mode rpc` process, so DSH's frontend works unchanged.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "pi",
    "pi-coding-agent",
    "cordis"
  ],
  "license": "MIT",
  "author": "Micheleww",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Micheleww/dsh-pi-agent.git"
  },
  "homepage": "https://github.com/Micheleww/dsh-pi-agent#readme",
  "bugs": {
    "url": "https://github.com/Micheleww/dsh-pi-agent/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0",
    "@deepseek-ai/dsh-scope": ">=0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@types/node": "^26.2.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
